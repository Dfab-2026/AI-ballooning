# Local: copy/edit backend/.env. Vercel: add the same values in Project Settings -> Environment Variables.
# Never commit real API keys.
GEMINI_API_KEY=PASTE_PRIMARY_API_KEY_HERE
GEMINI_API_KEY_FALLBACK=PASTE_SECOND_PROJECT_API_KEY_HERE
GEMINI_API_KEY_FALLBACK_2=

# High-quota primary model shown in AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional model fallback if the primary model itself is unavailable.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash

# Keep production requests gentle so six drawings do not burst the RPM quota.
GEMINI_ANALYSIS_MAX_DIM=1200
GEMINI_PARALLEL_WORKERS=1
ANALYSIS_TRANSIENT_RETRIES=1
GEMINI_MIN_CONFIDENCE=0.68
