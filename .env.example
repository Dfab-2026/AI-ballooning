# Primary Gemini key
GEMINI_API_KEY=PASTE_PRIMARY_API_KEY_HERE

# Optional fallback key. For quota fallback, create this key in a DIFFERENT
# Gemini/Google AI project so it has a separate quota pool.
GEMINI_API_KEY_FALLBACK=PASTE_SECOND_API_KEY_HERE

# Optional third key (leave blank if unused)
GEMINI_API_KEY_FALLBACK_2=

GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=
GEMINI_ANALYSIS_MAX_DIM=1400
GEMINI_PARALLEL_WORKERS=1
ANALYSIS_TRANSIENT_RETRIES=1
GEMINI_MIN_CONFIDENCE=0.68
