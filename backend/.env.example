# Copy this file to backend/.env for LOCAL development only.
# Never commit your real API key. On Vercel add these in Project Settings -> Environment Variables.
GEMINI_API_KEY=PASTE_YOUR_API_KEY_HERE

# Use a fast model that is enabled for your API project.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=

# Faster image payload while retaining drawing readability.
GEMINI_ANALYSIS_MAX_DIM=1600

# Independent drawings can be analysed concurrently. 2-3 is recommended.
GEMINI_PARALLEL_WORKERS=3

# Retry temporary 503/short 429 failures, but not daily quota exhaustion.
ANALYSIS_TRANSIENT_RETRIES=2
