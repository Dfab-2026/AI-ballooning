# Add your analysis API key here, then restart the backend.
GEMINI_API_KEY=PASTE_YOUR_API_KEY_HERE

# Use the model enabled for your API project.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=

# Analysis image optimization
GEMINI_ANALYSIS_MAX_DIM=2000

# Retry only temporary service errors. Daily quota exhaustion is not repeatedly retried.
ANALYSIS_TRANSIENT_RETRIES=1
